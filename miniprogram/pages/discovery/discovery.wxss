.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #10131c;
  box-sizing: border-box;
}

.status-bar {
  flex-shrink: 0;
}

.header {
  flex-shrink: 0;
  padding: 48rpx 32rpx 32rpx;
  position: relative;
}

.back-btn {
  position: absolute;
  left: 40rpx;
  top: 52rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.7);
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #f0f4ff;
  text-align: center;
  display: block;
}

.subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  text-align: center;
  display: block;
  margin-top: 8rpx;
}

.loading-state {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.4);
}

.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-icon {
  font-size: 80rpx;
  color: rgba(255, 255, 255, 0.15);
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.3);
}

.scroll-area {
  flex: 1;
  overflow: hidden;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.city-section {
  margin-bottom: 40rpx;
}

.city-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 0 20rpx;
}

.city-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #f0f4ff;
}

.city-count {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.35);
  font-family: 'DIN Alternate', 'Menlo', monospace;
}

.place-list {
  background: rgba(255, 255, 255, 0.02);
  border: 1rpx solid rgba(255, 255, 255, 0.04);
  border-radius: 20rpx;
  overflow: hidden;
}

.place-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  position: relative;
}

.place-item + .place-item {
  border-top: 1rpx solid rgba(255, 255, 255, 0.04);
}

.place-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #38bdf8;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.place-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.75);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.place-date {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.3);
  margin-left: 12rpx;
  flex-shrink: 0;
}

.bottom-space {
  height: 80rpx;
}

.summary-row {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 32rpx 8rpx;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-num {
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
}

.summary-label {
  color: rgba(255,255,255,0.4);
  font-size: 22rpx;
  margin-top: 6rpx;
}

.rarity-legend {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  padding: 16rpx 0 8rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.legend-text {
  color: rgba(255,255,255,0.45);
  font-size: 20rpx;
}

.place-rarity {
  font-size: 20rpx;
  margin-left: 12rpx;
}
